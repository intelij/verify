APP_NAME="SchoolRun Verify"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SchoolRun Verification Service
APP_URL=https://verify.schoolrun.space

VERIFICATION_STORAGE_DISK=documents
EXTRACTION_PROVIDERS=tesseract
TESSERACT_ENABLED=true
TESSERACT_BINARY=/usr/bin/tesseract
TESSERACT_LANGUAGE=eng
OCR_TIMEOUT=60
VERIFICATION_TIMEOUT=180
VERIFICATION_MAX_ATTEMPTS=3
VERIFICATION_MAX_UPLOAD_BYTES=12582912
WEBHOOK_TIMEOUT=15
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_SIGNATURE_TTL=300
STORE_RAW_OCR=false
DOCUMENT_RETENTION_DAYS=90
EXTRACTED_DATA_RETENTION_DAYS=180
VERIFICATION_RESULT_RETENTION_DAYS=730
API_RATE_LIMIT=60
MATCH_NAME_THRESHOLD=0.92
MATCH_NAME_REVIEW_THRESHOLD=0.72

# Optional AWS Textract fallback (off until configured)
TEXTRACT_ENABLED=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=

# First admin login (change immediately)
ADMIN_EMAIL=admin@schoolrun.space
ADMIN_PASSWORD=
